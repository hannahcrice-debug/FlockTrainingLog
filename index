function closePanel(){ const p = $("#editPanel"); p.classList.add("hide"); p.innerHTML = ""; }
function openPanel(mode){
  const p = $("#editPanel"), b = bird(sel);
  if(mode !== "add" && !b) return;
  if(mode === "rename"){
    p.innerHTML = '<label for="pfName">New name</label>' +
      '<input type="text" id="pfName" value="' + esc(b.name) + '">' +
      '<div class="row"><button class="primary" id="pfOk">Save name</button>' +
      '<button class="ghost" id="pfNo">Cancel</button></div>';
  } else if(mode === "remove"){
    p.innerHTML = '<p style="margin:0 0 10px;font-size:15px">Remove ' + esc(b.name) + ' and all of their progress? This cannot be undone.</p>' +
      '<div class="row"><button class="primary" id="pfOk">Remove ' + esc(b.name) + '</button>' +
      '<button class="ghost" id="pfNo">Keep them</button></div>';
  } else {
    p.innerHTML = '<label for="pfName">Name</label><input type="text" id="pfName" placeholder="Name">' +
      '<label for="pfType">Species</label><select id="pfType">' +
      '<option value="eclectus">Eclectus</option><option value="hahns">Hahn\'s macaw</option>' +
      '<option value="gcc" selected>Green cheek conure</option><option value="irn">Indian ringneck</option>' +
      '<option value="linnie">Lineolated parakeet</option><option value="budgie">Budgie</option></select>' +
      '<div class="row"><button class="primary" id="pfOk">Add bird</button>' +
      '<button class="ghost" id="pfNo">Cancel</button></div>';
  }
  p.classList.remove("hide");
  p.dataset.mode = mode;
  const f = $("#pfName"); if(f){ f.focus(); f.select(); }
}

$("#editPanel").addEventListener("click", e => {
  if(e.target.id === "pfNo"){ closePanel(); return; }
  if(e.target.id !== "pfOk") return;
  const mode = $("#editPanel").dataset.mode;
  if(mode === "rename"){
    const v = $("#pfName").value.trim(); if(!v) return;
    bird(sel).name = v;
  } else if(mode === "remove"){
    S.birds = S.birds.filter(x => x.id !== sel);
    delete S.progress[sel]; delete S.touched[sel];
    sel = S.birds.length ? S.birds[0].id : null;
  } else {
    const v = $("#pfName").value.trim(); if(!v) return;
    const t = $("#pfType").value;
    const labels = {eclectus:"Eclectus", hahns:"Hahn's macaw", gcc:"Green cheek conure", irn:"Indian ringneck", linnie:"Lineolated parakeet", budgie:"Budgie"};
    const id = "b" + Date.now();
    S.birds.push({id:id, name:v, species:labels[t], type:t, color:"#5F6854"});
    sel = id;
  }
  closePanel(); save(); renderAll();
});
