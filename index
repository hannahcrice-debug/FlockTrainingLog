function treatsFor(b){ return (TREATS[b.type]||[]).concat(S.custom[b.id]||[]); }
function treatState(bid, tid){ return (S.treats[bid] && S.treats[bid][tid]) || 0; }
function payWith(bid){
  const b = bird(bid); if(!b) return null;
  const list = treatsFor(b);
  const jack = list.find(t => treatState(bid,t.id) === 3);
  if(jack) return jack.n;
  const liked = list.find(t => treatState(bid,t.id) === 2);
  return liked ? liked.n : null;
}

