  document.querySelectorAll(".minopt").forEach(m => m.setAttribute("aria-pressed", (+m.dataset.min) === (S.qmin||5)));

  const ranked = S.birds.slice().sort((a,b) => daysSince(b.id) - daysSince(a.id));
  $("#planList").innerHTML = ranked.map(b => {
    const sk = nextSkill(b);
    const d = daysSince(b.id);
    const when = d === 999 ? "never trained" : d === 0 ? "trained today" : d === 1 ? "yesterday" : d + " days ago";
    if(!sk) return '<div class="plan done"><div class="who">' + esc(b.name) + '</div><div class="what">Everything is solid. Pick a favorite and keep it sharp.</div></div>';
    const st = stage(b.id, sk);
    const did = loggedToday(b.id, sk);
    return '<div class="plan' + (did?' done':'') + '">' +
      '<div class="who">' + esc(b.name) +
        ' <span style="font-weight:400;color:var(--soft);font-size:13px">\u00b7 ' + when + '</span></div>' +
      '<div class="what"><b>' + esc(SKILLS[sk].n) + '</b> \u00b7 ' + STAGE_LABEL[st] + '<br>' + esc(SKILLS[sk].h) +
        (payWith(b.id) ? '<br><span style="color:var(--gold)">Pay with: ' + esc(payWith(b.id)) + '</span>' : '') + '</div>' +
      '<div class="planacts">' +
        (did
          ? '<span class="checkmark">Logged ' + did.min + ' min today</span>' +
            '<button class="act sec" data-note="' + did.id + '">' + (did.note ? "Edit note" : "Add note") + '</button>' +
            '<button class="act sec" data-undo-sess="' + did.id + '">Undo</button>' +
            (did.note ? '<div style="flex-basis:100%;font-size:13.5px;color:var(--soft);margin-top:2px">' + esc(did.note) + '</div>' : '')
          : '<button class="act" data-log="' + b.id + '|' + sk + '">Log ' + (S.qmin||5) + ' min</button>') +
        (st < 3 ? '<button class="act sec" data-bump="' + b.id + '|' + sk + '">Move to ' + STAGE_LABEL[st+1] + '</button>' : '') +
      '</div></div>';
  }).join("") || '<p class="empty">Add a bird to get started.</p>';

  const rc = recapList();
  $("#recapList").innerHTML = rc.length
    ? rc.map(r => {
        const did = loggedToday(r.b.id, r.sk);
        return '<div class="plan recap' + (did?' done':'') + '">' +
          '<div class="who">' + esc(r.b.name) + ' \u00b7 ' + esc(SKILLS[r.sk].n) + '</div>' +
          '<div class="what">Last worked ' + r.d + ' days ago.</div>' +
          '<div class="planacts">' + (did
            ? '<span class="checkmark">Recapped today</span>'
            : '<button class="act" data-log="' + r.b.id + '|' + r.sk + '">Ran it</button>') +
          '</div></div>';
      }).join("")
    : '<p class="empty">Nothing has gone stale yet.</p>';

  const td = S.sessions.filter(s => isToday(s.when));
  $("#todayLog").innerHTML = td.length
    ? td.map(s => {
        const b = bird(s.bird);
        const names = (s.skills||[]).map(k => SKILLS[k] ? SKILLS[k].n : k).join(", ");
        return '<div class="entry"><button class="del" data-undo-sess="' + s.id + '">remove</button>' +
          '<span class="who">' + esc(b ? b.name : "Removed bird") + '</span> ' +
          '<span class="meta">' + s.min + ' min</span>' +
          (names ? '<div class="meta">' + esc(names) + '</div>' : '') +
          (s.note ? '<div class="body">' + esc(s.note) + '</div>' : '') + '</div>';
      }).join("")
    : '<p class="empty">Nothing logged yet today. Tap a Log button above, or use the Log tab to add notes.</p>';
}

