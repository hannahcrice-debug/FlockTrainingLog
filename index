function weightsFor(bid){ return (S.weights[bid] || []).slice().sort((a,b) => new Date(b.d) - new Date(a.d)); }
function weightFlag(bid){
  const w = weightsFor(bid); if(!w.length) return null;
  const cur = w[0].g, fl = S.floor[bid];
  if(fl && cur < fl) return {kind:"low", msg:"Below the floor weight you set. Feed up and call your vet before training."};
  const recent = w.slice(1,8);
  if(recent.length >= 3){
    const avg = recent.reduce((a,x) => a + x.g, 0) / recent.length;
    const drop = (avg - cur) / avg * 100;
    if(drop >= 5) return {kind:"low", msg:"Down " + drop.toFixed(1) + "% from the recent average. Worth a vet call."};
    if(drop >= 3) return {kind:"watch", msg:"Down " + drop.toFixed(1) + "% from the recent average. Keep an eye on it."};
  }
  return null;
}
function sparkline(bid){
  const w = weightsFor(bid).slice(0,20).reverse();
  if(w.length < 2) return "";
  const gs = w.map(x => x.g), lo = Math.min.apply(null,gs), hi = Math.max.apply(null,gs);
  const span = (hi - lo) || 1, W = 240, H = 40;
  const pts = w.map((x,i) => (i/(w.length-1)*W).toFixed(1) + "," + (H - (x.g-lo)/span*(H-6) - 3).toFixed(1)).join(" ");
  return '<svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="none" style="width:100%;height:44px;margin-top:8px">' +
    '<polyline points="' + pts + '" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>' +
    '</svg><div style="display:flex;justify-content:space-between;font-size:11px;color:var(--soft)"><span>' +
    lo + ' g</span><span>last ' + w.length + ' readings</span><span>' + hi + ' g</span></div>';
}

