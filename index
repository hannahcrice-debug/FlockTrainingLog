function tChime(){
  try{
    const C = window.AudioContext || window.webkitAudioContext; if(!C) return;
    const ac = new C();
    [0, 0.28, 0.56].forEach((off, i) => {
      const o = ac.createOscillator(), g = ac.createGain();
      o.type = "sine"; o.frequency.value = i === 2 ? 1046 : 784;
      g.gain.setValueAtTime(0.0001, ac.currentTime + off);
      g.gain.exponentialRampToValueAtTime(0.22, ac.currentTime + off + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, ac.currentTime + off + 0.24);
      o.connect(g); g.connect(ac.destination);
      o.start(ac.currentTime + off); o.stop(ac.currentTime + off + 0.26);
    });
  }catch(err){ /* audio blocked, the clock still reads 0:00 */ }
}
function tReset(){
  if(tId) clearInterval(tId); tId = null; tRemain = 0;
  $("#timerBar").className = "timerbar"; $("#tClock").textContent = "0:00";
  $("#tNote").textContent = "Runs for your chosen session length, then chimes. Keep both hands on the bird.";
}
$("#tStart").addEventListener("click", () => {
  if(tId) return;
  tRemain = (S.qmin || 5) * 60; tShow();
  $("#timerBar").className = "timerbar running";
  $("#tNote").textContent = "Running. Stop while the bird still wants more, and finish on something easy.";
  tId = setInterval(() => {
    tRemain--; tShow();
    if(tRemain <= 0){
      clearInterval(tId); tId = null;
      $("#timerBar").className = "timerbar done";
      $("#tNote").textContent = "Time. End on a win, then log it above.";
      tChime();
    }
  }, 1000);
});
$("#tStop").addEventListener("click", tReset);

// ---- note on a quick-logged session ----
$("#planList").addEventListener("click", e => {
  const n = e.target.closest("[data-note]"); if(!n) return;
  const s = S.sessions.find(x => x.id === n.dataset.note); if(!s) return;
  const holder = n.parentNode;
  if(holder.querySelector(".noteedit")) return;
  const box = document.createElement("div");
  box.className = "noteedit";
  box.style.cssText = "flex-basis:100%;margin-top:8px";
  box.innerHTML = '<textarea id="qnText" placeholder="Took the target three times, lost interest after that."></textarea>' +
    '<div class="row"><button class="act" id="qnSave">Save note</button><button class="act sec" id="qnCancel">Cancel</button></div>';
  holder.appendChild(box);
  const ta = box.querySelector("#qnText"); ta.value = s.note || ""; ta.focus();
  box.querySelector("#qnCancel").addEventListener("click", ev => { ev.stopPropagation(); renderAll(); });
  box.querySelector("#qnSave").addEventListener("click", ev => {
    ev.stopPropagation(); s.note = ta.value.trim(); save(); renderAll();
  });
});


load();
